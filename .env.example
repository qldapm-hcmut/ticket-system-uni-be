# API listen address (default :3000); shared config also validates this for worker.
HTTP_ADDR=:3000
# Required by API and worker. Local credentials only; keep in sync with Compose below.
DATABASE_URL=postgres://ticket:ticket_local@localhost:5432/ticket?sslmode=disable
# Local Compose settings, not application configuration.
POSTGRES_PASSWORD=ticket_local
POSTGRES_PORT=5432

# Required by API only; Google OAuth client ID, not a client secret.
GOOGLE_CLIENT_ID=
# Independent random signing keys, each at least 32 bytes excluding edge whitespace.
# Generate each separately with: openssl rand -hex 32
# Values are used literally, not hex/base64-decoded. Never commit real keys.
JWT_SECRET=
QR_HMAC_SECRET=

# Mailpit Compose ports. If SMTP port changes, update SMTP_PORT too.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Worker runs on the host; Mailpit captures demo mail without external delivery.
# Enable exactly one email consumer. API never requires SMTP configuration.
# Set false for API-only setup; disabled leaves PENDING messages untouched.
EMAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=events@example.test
# local: loopback IP literals only, no credentials (Mailpit demo).
# Remote relay: starttls (usually 587) or tls (usually 465), verified TLS required.
SMTP_TLS_MODE=local
SMTP_USERNAME=
SMTP_PASSWORD=
